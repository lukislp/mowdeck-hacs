{
  "entity": {
    "sensor": {
      "activity": { "default": "mdi:robot-mower" },
      "rtk_fix": { "default": "mdi:crosshairs-gps" },
      "rtk_source": { "default": "mdi:satellite-uplink" },
      "connection": { "default": "mdi:lan-connect" },
      "blade_height": { "default": "mdi:arrow-expand-vertical" },
      "error_code": { "default": "mdi:alert-circle-outline" },
      "bridge_signal": { "default": "mdi:bluetooth" },
      "blade_hours": { "default": "mdi:saw-blade" },
      "mowing_hours": { "default": "mdi:timer-outline" },
      "mowing_distance": { "default": "mdi:map-marker-distance" },
      "battery_cycles": { "default": "mdi:battery-sync-outline" },
      "next_mow": { "default": "mdi:calendar-clock" },
      "last_schedule_run": { "default": "mdi:calendar-check" },
      "rain_pause_until": { "default": "mdi:weather-rainy" },
      "lawn_wet_until": { "default": "mdi:water-outline" },
      "mowing_time_today": { "default": "mdi:timer-sand" },
      "distance_today": { "default": "mdi:map-marker-path" },
      "jobs_today": { "default": "mdi:counter" },
      "online_time_today": { "default": "mdi:access-point" }
    },
    "button": {
      "emergency_stop": { "default": "mdi:alert-octagon" },
      "return_to_dock": { "default": "mdi:home-import-outline" },
      "end_job": { "default": "mdi:stop-circle-outline" },
      "firmware_check": { "default": "mdi:cloud-search-outline" },
      "blade_changed": { "default": "mdi:saw-blade" },
      "schedule_run_now": { "default": "mdi:play-circle-outline" },
      "schedule_skip_next": { "default": "mdi:skip-next-circle-outline" }
    },
    "number": {
      "blade_height": { "default": "mdi:arrow-expand-vertical" },
      "speed": { "default": "mdi:speedometer" },
      "drive_speed": { "default": "mdi:gamepad-variant-outline" },
      "mow_angle": { "default": "mdi:angle-acute" },
      "mow_border_laps": { "default": "mdi:vector-square" },
      "mow_path_spacing": { "default": "mdi:arrow-expand-horizontal" }
    },
    "select": {
      "area": { "default": "mdi:texture-box" },
      "mow_pattern": { "default": "mdi:texture" }
    },
    "switch": {
      "light": { "default": "mdi:lightbulb-outline", "state": { "on": "mdi:lightbulb-on" } },
      "schedule": { "default": "mdi:calendar-blank", "state": { "on": "mdi:calendar-check" } },
      "area": { "default": "mdi:texture-box" }
    },
    "device_tracker": {
      "position": { "default": "mdi:map-marker" }
    },
    "binary_sensor": {
      "rain_hold": { "default": "mdi:weather-pouring", "state": { "off": "mdi:weather-partly-cloudy" } }
    },
    "event": {
      "command": { "default": "mdi:console-line" },
      "notification": { "default": "mdi:bell-ring-outline" }
    }
  },
  "services": {
    "start_mow": { "service": "mdi:play" },
    "emergency_stop": { "service": "mdi:alert-octagon" },
    "set_blade_height": { "service": "mdi:arrow-expand-vertical" },
    "set_speed": { "service": "mdi:speedometer" },
    "get_map": { "service": "mdi:map" },
    "get_heatmap": { "service": "mdi:grid" }
  }
}
