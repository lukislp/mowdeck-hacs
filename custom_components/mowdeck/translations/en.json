    "spot_outside_areas": {
      "message": "The spot does not lie completely inside one mapped area of the mower."
    },
    "spot_busy": {
      "message": "The mower must be idle (or docked, where it can leave the dock by itself) with no job or spot run active."
    },
    "spot_battery": {
      "message": "The battery must be above 20 % for a spot run."
    },
    "spot_rtk": {
      "message": "The mower has no fixed RTK position. Wait for an RTK fix."
    },
    "spot_no_route": {
      "message": "MowDeck found no way to the spot: {reason}"
    }
  },
  "issues": {
    "realtime_unauthorized": {
      "title": "MowDeck live updates are refused",
      "description": "MowDeck at {url} refuses the live connection even with a fresh access token, so Home Assistant only polls every few minutes. Check that the API token still exists and has the permission mower.view, or create a new token and enter it with Reconfigure on the integration. This message disappears as soon as the live connection works again."
    },
    "health_forbidden": {
      "title": "MowDeck refuses the mower health data",
      "description": "MowDeck at {url} answers the health totals (blade hours, mowing hours, distance, battery cycles) with \"forbidden\" for this API token, so these sensors are unavailable. Grant the permission {permission} to the token in the MowDeck app. This message disappears with the next successful update."
    },
    "scheduler_forbidden": {
      "title": "MowDeck refuses the schedules",
      "description": "MowDeck at {url} answers the schedules or the rain decision with \"forbidden\" for this API token, so the schedule and rain entities are unavailable. Grant the permission {permission} (it follows mower.view) to the token in the MowDeck app. This message disappears with the next successful update."
    },
    "ble_bridge_outdated": {
      "title": "The Bluetooth bridge of {mower} needs a firmware update",
      "description": "MowDeck reports that the Bluetooth bridge of {mower} runs firmware older than MowDeck expects (reason: {reason}; ESPHome {esphome_version}, MowDeck bridge template {project_version}). Driving and spot runs over the bridge may fail until it is updated. Build and flash the bridge again from the current MowDeck bridge template (see the mower page in MowDeck). This message disappears once the bridge reports current firmware."
    },
    "missing_permission_notifications": {
      "title": "The MowDeck API token receives no notifications",
      "description": "The API token lacks the permission {permission}, so MowDeck pushes no notifications to Home Assistant and the notification entities stay silent. Grant mower.view on the whole account (not a site, group or mower) to the token at {url}. A token created before MowDeck 0.7.0 must be issued again with the same grants; enter the new token with Reconfigure on the integration. This message disappears once the token holds {permission} (checked every 10 minutes)."
    },
    "heatmap_forbidden": {
      "title": "MowDeck refuses the heatmaps",
      "description": "MowDeck at {url} answers the heatmaps with \"forbidden\" for this API token, so the heatmap images and the missed area are unavailable. Grant the permission {permission} to the token in the MowDeck app. This message disappears with the next successful update."
    }
  },
