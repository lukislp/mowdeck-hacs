{
  "config": {
    "step": {
      "user": {
        "title": "Connect to MowDeck",
        "description": "Enter the address of your MowDeck installation and an API token created in the MowDeck app (Settings, API tokens) with the permissions mower.view and mower.control. Grant mower.view on the whole account to receive MowDeck notifications.",
        "data": {
          "url": "URL",
          "api_token": "API token"
        },
        "data_description": {
          "url": "Base URL of the MowDeck web app, for example {example_url}",
          "api_token": "The token is shown only once when it is created."
        }
      },
      "reauth_confirm": {
        "title": "Renew the MowDeck API token",
        "description": "The API token for {url} was revoked or has expired. Create a new token in the MowDeck app and enter it here.",
        "data": {
          "api_token": "API token"
        }
      },
      "reconfigure": {
        "title": "Reconfigure MowDeck",
        "description": "Change the address of your MowDeck installation, for example after it moved. Enter a new API token only if you want to replace the current one; it must belong to the same MowDeck account.",
        "data": {
          "url": "URL",
          "api_token": "API token"
        },
        "data_description": {
          "url": "Base URL of the MowDeck web app, for example {example_url}",
          "api_token": "Optional. Leave empty to keep the current token."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach MowDeck at this URL.",
      "invalid_auth": "The API token is invalid, expired or revoked.",
      "invalid_url": "Enter an http or https URL.",
      "missing_permission": "The API token lacks the permission mower.view.",
      "no_account": "This token belongs to no MowDeck account.",
      "unknown": "Unexpected error, see the log."
    },
    "abort": {
      "already_configured": "This MowDeck account is already configured.",
      "reauth_successful": "The API token was updated.",
      "wrong_account": "The new token belongs to another MowDeck account.",
      "reconfigure_successful": "The MowDeck connection was updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "MowDeck options",
        "data": {
          "poll_interval": "Poll interval",
          "expose_emergency_stop": "Show the emergency stop button",
          "persistent_notifications": "Persistent notifications"
        },
        "data_description": {
          "poll_interval": "Seconds between API polls while the live connection is down.",
          "expose_emergency_stop": "Adds an emergency stop button per mower. The action mowdeck.emergency_stop is always available.",
          "persistent_notifications": "Also show MowDeck notifications of this severity or higher as persistent notifications in Home Assistant. The event entities and the mowdeck_notification event get every notification regardless."
        }
      }
    }
  },
