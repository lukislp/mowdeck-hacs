  "exceptions": {
    "command_failed": {
      "message": "MowDeck command {command} failed: {error}"
    },
    "command_forbidden": {
      "message": "The API token may not send {command}. Grant {permission} to the token in the MowDeck app."
    },
    "camera_relay_unsupported": {
      "message": "MowDeck's camera relay cannot serve this mower. Enable the camera relay (and for Mammotion mowers the Agora bridge) in MowDeck"
    },
    "camera_unsupported": {
      "message": "This mower has no camera MowDeck can show"
    },
    "camera_budget": {
      "message": "A camera limit of the mower refused the stream (video budget or battery)"
    },
    "camera_forbidden": {
      "message": "MowDeck refused the camera: the plan does not include the camera, or the API token lacks mower.view"
    },
    "camera_not_found": {
      "message": "The mower is not visible to the API token"
